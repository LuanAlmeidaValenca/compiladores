[numero CalcTrig [numero angulo]:
    [
        [ numero SEN [Seno[angulo]]]
        [ numero COS [Cosseno[angulo]]]
        [ numero TAN [Tangente[angulo]]]
        <SEN + COS> + TAN
    ]
]

[numero Analisa [numero base | numero divisor]:
    [
        [ numero NUMLOG [Logaritmo[base]]]
        [ numero DIVISORINT [base // divisor]]
        [
            || <DIVISORINT >> 0> = NUMLOG + DIVISORINT
            || # = NUMLOG
        ]
    ]
]

[ numero ExecutaOperacao [ numero Operacao [ numero ] | numero valorAngulo ] :
	[ Operacao[valorAngulo] ]
]

++ [numero Principal []:
	[
        	[ numero RESULTADOTRIG [ ExecutaOperacao[CalcTrig | 0,0] ] ]
        	[ numero RESULTADOANALISE [ Analisa[100 | 3] ] ]
        
        	RESULTADOTRIG + RESULTADOANALISE
    	]
]
