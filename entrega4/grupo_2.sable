Package quinas;

Helpers
    /* Caracteres Básicos */
    digito = ['0' .. '9'];
    digito_bin = ['0' .. '1'];
    letra_min = ['a' .. 'z'];
    letra_mai = ['A' .. 'Z'];
    letra = letra_min | letra_mai;
    
    /* Quebras de linha e Espaços */
    cr = 13;
    lf = 10;
    tab = 9;
    espaco_char = ' ';
    virgula = ',';
    
    /* Conjunto para Comentários */
    qualquer_caractere = [0 .. 65535];
    fim_linha = cr | lf | cr lf;

Tokens
    /* Palavras Reservadas de Tipos Primitivos */
    tipo_numero = 'numero';
    tipo_booleano = 'booleano';

    /* Valores Booleanos */
    bool_v = 'V';
    bool_f = 'F';

    /* Delimitadores e Marcadores */
    ponto_entrada = '++';
    l_colchete = '[';
    r_colchete = ']';
    dois_pontos = ':';
    barra_vert = '|';
    barra_vert_dupla = '||';
    sustenido = '#';

    /* Operadores Aritméticos */
    mais = '+';
    menos = '-';
    multiplicacao = '.';
    resto = '\'; /* esse bloco de comentário serve apenas para resolver um bug visual da extensão sable-helper'*/
    divisao_int = '//';
    barra = '/';
    potencia = 180 | 8216 | 8217 | '´';

    /* Operadores Relacionais */
    igualdade = '==';
    igual = '=';
    menor = '<<';
    menor_precedencia = '<';
    maior = '>>';
    maior_precedencia = '>';

    /* Operadores Lógicos */
    e_logico = '^';
    nao_logico = '¬' | 172 | '~';
    ou_logico = 'v';

    /* Numerais */
    numeral_int = digito+ | '0b' digito_bin+;
    numeral_real = digito+ virgula digito+;

    /* Identificadores */
    id_const = letra_mai letra_mai+;
    id_funcao = letra_mai letra+;
    id = letra_min letra_min+;

    /* Espaços em Branco e Comentários */
    vazio = (espaco_char | tab | cr | lf)+;
    comentario_linha = '--' [qualquer_caractere - [cr + lf]]* fim_linha?;
    comentario_bloco = '/--' ( [qualquer_caractere - '-'] | '-' [qualquer_caractere - '-'] | '--' [qualquer_caractere - '/'] )* '--/';

Ignored Tokens
    vazio,
    comentario_linha,
    comentario_bloco;

Productions
    programa {-> programa} =
    dec_funcao+ {-> New programa([dec_funcao])};

    dec_funcao {-> dec_funcao} =
    ponto_entrada? [abre_funcao]:l_colchete tipo id_funcao 
    [colchete_param_l]:l_colchete lista_parametros [colchete_param_r]:r_colchete dois_pontos 
    [colchete_exp_l]:l_colchete exp [colchete_exp_r]:r_colchete [fecha_funcao]:r_colchete
    {-> New dec_funcao(ponto_entrada, tipo, id_funcao, [lista_parametros.parametro], exp)};

    tipo {-> tipo} =
    {numero} tipo_numero {-> New tipo.numero()}|
    {booleano} tipo_booleano {-> New tipo.booleano()};

    lista_parametros {-> parametro*} =
    {vazio} {-> []} |
    {parametros} parametro separador_parametro* {-> [parametro, separador_parametro.parametro]};

    separador_parametro {-> parametro} =
    barra_vert parametro {-> parametro};

    parametro {-> parametro} =
    {tipo_id} tipo id {-> New parametro.tipo_id(tipo, id)} |
    {assinatura} assinatura {-> New parametro.assinatura(assinatura)};

    assinatura {-> assinatura} = 
    tipo id_funcao l_colchete parametros_assinatura r_colchete {->New assinatura(tipo, id_funcao, [parametros_assinatura.parametro_assinatura])};

    parametros_assinatura {-> parametro_assinatura*} = 
    {vazio} {-> []} |
    {params_assinaturas} parametro_assinatura separador_assinatura* {-> [parametro_assinatura, separador_assinatura.parametro_assinatura]};

    separador_assinatura {-> parametro_assinatura} = 
    barra_vert parametro_assinatura {-> parametro_assinatura};

    parametro_assinatura {-> parametro_assinatura} = 
    {tipo} tipo {-> New parametro_assinatura.tipo(tipo)} |
    {assinatura} assinatura {-> New parametro_assinatura.assinatura(assinatura)};


    exp {-> exp} = 
    {ou} exp ou_logico exp_e {-> New exp.ou(exp, exp_e.exp)} |
    {passa_e} exp_e {-> exp_e.exp};

    exp_e {-> exp} = 
    {e} exp_e e_logico exp_igual {-> New exp.e(exp_e.exp, exp_igual.exp)} |
    {passa_igual} exp_igual {-> exp_igual.exp};

    exp_igual {-> exp} =
    {equacao} exp_igual igualdade exp_menor {-> New exp.igualdade(exp_igual.exp, exp_menor.exp)} |
    {passa_menor} exp_menor {-> exp_menor.exp};

    exp_menor {-> exp} =
    {menor_que} exp_menor menor exp_soma {-> New exp.menor(exp_menor.exp, exp_soma.exp)} |
    {maior_que} exp_menor maior exp_soma {-> New exp.maior(exp_menor.exp, exp_soma.exp)} |
    {passa_soma} exp_soma {-> exp_soma.exp};

    exp_soma {-> exp} = 
    {soma} exp_soma mais exp_mult {-> New exp.soma(exp_soma.exp, exp_mult.exp)} |
    {subtracao} exp_soma menos exp_mult {-> New exp.subtracao(exp_soma.exp, exp_mult.exp)}|
    {passa_mult} exp_mult {-> exp_mult.exp};

    exp_mult {-> exp} =
    {multiplicacao} exp_mult multiplicacao exp_potencia {-> New exp.multiplicacao(exp_mult.exp, exp_potencia.exp)} |
    {divisao} exp_mult barra exp_potencia {-> New exp.divisao(exp_mult.exp, exp_potencia.exp)} |
    {divisao_int} exp_mult divisao_int exp_potencia {-> New exp.divisao_int(exp_mult.exp, exp_potencia.exp)} |
    {resto} exp_mult resto exp_potencia {-> New exp.resto(exp_mult.exp, exp_potencia.exp)}|
    {passa_potencia} exp_potencia {-> exp_potencia.exp};

    exp_potencia {-> exp} = 
    {potencia} exp_negacao potencia exp_potencia {-> New exp.potencia(exp_negacao.exp, exp_potencia.exp)} |
    {passa_negacao} exp_negacao {-> exp_negacao.exp};

    exp_negacao {-> exp} = 
    {negacao} nao_logico exp_negacao {-> New exp.negacao(exp_negacao.exp)} |
    {negativo} menos exp_base {-> New exp.negativo(exp_base.exp)} |
    {passa_base} exp_base {-> exp_base.exp};

    exp_base {-> exp} =
    {parentesis} menor_precedencia exp maior_precedencia {-> New exp.parentesis(exp)} |
    {numeral_int} numeral_int {-> New exp.numeral_int(numeral_int)} | 
    {numeral_real} numeral_real {-> New exp.numeral_real(numeral_real)} |
    {bool_v} bool_v {-> New exp.bool_v()} |
    {bool_f} bool_f {-> New exp.bool_f()} |
    {id} id {-> New exp.id(id)} |
    {id_const} id_const {-> New exp.id_const(id_const)} |
    {bloco_exp} bloco_exp {-> New exp.bloco_exp(bloco_exp)} |
    {chamada} chamada {-> New exp.chamada(chamada)} |
    {guarda} guarda {-> New exp.guarda(guarda)};


    guarda {-> guarda} = 
    l_colchete clausula+ senao r_colchete {-> New guarda([clausula], senao.exp)};

    clausula {-> clausula} = 
    barra_vert_dupla [condicao]:exp igual [retorno]:exp {-> New clausula(condicao.exp, retorno.exp)};

    senao {-> exp} = 
    barra_vert_dupla sustenido igual exp {-> exp};

    bloco_exp {-> bloco_exp} = 
    l_colchete dec_cons+ exp r_colchete {-> New bloco_exp([dec_cons], exp)};

    dec_cons {-> dec_cons} = 
    [abre]:l_colchete tipo id_const [abre_exp]:l_colchete exp [fecha_exp]:r_colchete [fecha]:r_colchete {-> New dec_cons(tipo, id_const, exp)};

    chamada {-> chamada} = 
    id_funcao l_colchete lista_args r_colchete {-> New chamada(id_funcao, [lista_args.arg])};

    lista_args {-> arg*} = 
    {vazio} {-> []} |
    {argumentos} arg separador_arg* {-> [arg, separador_arg.arg]};

    separador_arg {-> arg} = 
    barra_vert arg {-> arg};

    arg {-> arg} = 
    {exp} exp {-> New arg.exp(exp)} |
    {id_funcao} id_funcao {-> New arg.id_funcao(id_funcao)};

Abstract Syntax Tree
    programa = dec_funcao*;

    dec_funcao = ponto_entrada? tipo id_funcao parametro* exp;

    tipo = 
        {numero} |
        {booleano};

    parametro = 
        {tipo_id} tipo id |
        {assinatura} assinatura;

    assinatura = tipo id_funcao parametro_assinatura*;

    parametro_assinatura = 
        {tipo} tipo |
        {assinatura} assinatura;

    exp = 
        {ou} [esq]:exp [dir]:exp |
        {e} [esq]:exp [dir]:exp |
        {igualdade} [esq]:exp [dir]:exp |
        {menor} [esq]:exp [dir]:exp |
        {maior} [esq]:exp [dir]:exp |
        {soma} [esq]:exp [dir]:exp |
        {subtracao} [esq]:exp [dir]:exp |
        {multiplicacao} [esq]:exp [dir]:exp |
        {divisao} [esq]:exp [dir]:exp |
        {divisao_int} [esq]:exp [dir]:exp |
        {resto} [esq]:exp [dir]:exp |
        {potencia} [esq]:exp [dir]:exp |
        {negacao} exp |
        {negativo} exp |
        {parentesis} exp |
        {numeral_int} numeral_int |
        {numeral_real} numeral_real |
        {bool_v} |
        {bool_f} |
        {id} id |
        {id_const} id_const |
        {bloco_exp} bloco_exp |
        {chamada} chamada |
        {guarda} guarda;

    guarda = clausula* [senao]:exp;

    clausula = [condicao]:exp [retorno]:exp;

    bloco_exp = dec_cons* exp;

    dec_cons = tipo id_const exp;

    chamada = id_funcao arg*;

    arg = 
        {exp} exp |
        {id_funcao} id_funcao;